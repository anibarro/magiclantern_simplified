# Keep XPan files identical between Windows and WSL checkouts. Scoped to
# these paths so files that upstream stores with CRLF are not renormalised.
build_tools/*.py text eol=lf
build_tools/*.sh text eol=lf
modules/*.py text eol=lf
extras/XPan_tools/*.py text eol=lf
data/XPAN/*.CUBE text eol=lf
*.cmd text eol=crlf
*.npy binary
